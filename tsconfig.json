{
  // Standalone typecheck config for the GrokBot pet bundle. No monorepo
  // project references: @deepseek-ai/* types resolve from node_modules
  // (devDependencies). Only the browser client sources are checked here.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["src"]
}
